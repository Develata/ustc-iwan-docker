# Production: pin a reviewed wrapper/upstream release.
IWAN_IMAGE_TAG=v2.2.0

# 1-based index shown by: docker compose run --rm iwan list
IWAN_SERVER_INDEX=1

# Host loopback port for SOCKS5.
IWAN_HOST_PORT=1080

# Usually leave these defaults unchanged.
IWAN_SOCKS_MTU=1380
IWAN_HEALTHCHECK_URL=https://api.llm.ustc.edu.cn/
IWAN_HEALTHCHECK_TIMEOUT=10
IWAN_WATCHDOG_INTERVAL=30
IWAN_WATCHDOG_FAILURES=4
IWAN_STARTUP_GRACE=20
